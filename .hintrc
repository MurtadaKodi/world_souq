{
  "extends": [
    "development"
  ],
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 125",
    "not chrome <= 125",
    "not edge <= 125",
    "not firefox <= 126",
    "not safari <= 17.5",
    "not samsung <= 25",
    "not and_ff <= 126",
    "not opera <= 110"
  ],
  "hints": {
    "axe/language": [
      "default",
      {
        "html-has-lang": "off"
      }
    ],
    "disown-opener": "off"
  }
}